# FrameFlow configuration. Copy to .env (optional; every value has a default). No API keys are needed.
FRAMEFLOW_DATA_DIR=./data             # projects, media, renders, exports, SQLite db
FRAMEFLOW_MAX_UPLOAD_MB=4096          # per-file upload limit
FRAMEFLOW_WHISPER_MODEL=base          # tiny | base | small | medium (downloaded on first use)
FRAMEFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Text-to-video (describe a video, no footage needed). Get a token at replicate.com/account/api-tokens.
# REPLICATE_API_TOKEN=
# FRAMEFLOW_T2V_MODEL=minimax/video-01        # any Replicate text-to-video model "owner/name"
# FRAMEFLOW_T2V_CLIP_SECONDS=6                # length one scene is generated at (fixed by the model)
# FRAMEFLOW_T2V_MAX_SCENES=12                 # scenes per video; description must fit 12 x 1800 characters
# FRAMEFLOW_T2V_INPUT={"prompt": "{prompt}"}  # model input template; {prompt} {aspect} {seconds} are filled in
# Image to Animation uses the same REPLICATE_API_TOKEN:
# FRAMEFLOW_I2V_MODEL=wan-video/wan-2.2-i2v-fast   # any Replicate image-to-video model "owner/name"
# FRAMEFLOW_I2V_INPUT={"image": "{image}", "prompt": "{prompt}"}   # {image} {prompt} {aspect} {seconds} {motion}
